# RT Finance API — variáveis de ambiente. Copie para apps/api/.env
# (a raiz tem um .env.example mais completo com WhatsApp/IA/backups).

NODE_ENV=development
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo
APP_DEFAULT_CURRENCY=BRL

# Ajuste para o seu PostgreSQL
DATABASE_URL=postgresql://rtfinance:rtfinance@127.0.0.1:5432/rtfinance?schema=public

# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0001
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-0002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_NAME=rt_refresh
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

LOG_LEVEL=info

# IA — "nvidia" (real) ou "mock" (regras locais, sem rede). Cai em mock se faltar a key.
AI_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_MS=25000
# Transcrição de áudio do WhatsApp (Groq Whisper). Vazio = áudios recusados com aviso.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# WHATSAPP_PROVIDER: "evolution" (real) ou "console" (dev — só loga o que enviaria)
WHATSAPP_PROVIDER=console
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=rtfinance
# Token compartilhado que a Evolution manda no header do webhook (x-webhook-token) ou ?token=
WHATSAPP_WEBHOOK_TOKEN=
# Telefones autorizados (E.164, separados por vírgula). Vazio = libera qualquer número (só dev).
# opcional. vazio = a autorização vem dos telefones dos membros (tela Configurações > WhatsApp).
# se preenchido, funciona como trava global EXTRA (E.164 separados por vírgula).
WHATSAPP_ALLOWLIST=

AI_CONFIRM_THRESHOLD_CENTS=50000
PENDING_CONFIRMATION_TTL_MINUTES=30
RECURRING_HORIZON_MONTHS=2
JOBS_ENABLED=true

# Seed (pnpm db:seed)
SEED_HOUSEHOLD_NAME=Casa RT
SEED_OWNER_NAME=Filipe
SEED_OWNER_EMAIL=filipe@rtfinance.local
SEED_OWNER_PASSWORD=rtfinance123
SEED_OWNER_PHONE=
SEED_PARTNER_NAME=Julia
SEED_PARTNER_EMAIL=julia@rtfinance.local
SEED_PARTNER_PASSWORD=rtfinance123
SEED_PARTNER_PHONE=
