# Template nginx — o entrypoint da imagem roda envsubst nas variáveis abaixo ao subir:
#   ${API_UPSTREAM}    host:porta da API   (compose: api:3333 · Fly: rt-finance-api.internal:8080)
#   ${NGINX_RESOLVER}  DNS interno         (compose: 127.0.0.11 · Fly: [fdaa::3]:53)
# proxy_pass com variável = resolução preguiçosa: o nginx sobe mesmo se a API ainda
# não resolver (deploy fora de ordem, cold start).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # uploads de importação (OFX/PDF/imagem) e anexos podem passar de 1 MB
  client_max_body_size 20m;

  # assets com hash no nome → cache longo
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location /api/ {
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    set $rt_api "${API_UPSTREAM}";
    proxy_pass http://$rt_api$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
