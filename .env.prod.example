# RT Finance — produção. Copie para .env.prod e preencha.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Leia o SECURITY.md antes.

# domínio público (mesmo host serve painel e /api atrás do seu proxy TLS)
API_PUBLIC_URL=https://rtfinance.seudominio.com
WEB_ORIGIN=https://rtfinance.seudominio.com
AUTH_COOKIE_DOMAIN=rtfinance.seudominio.com

# porta local do nginx do painel (seu proxy TLS aponta 443 -> aqui)
WEB_PORT=8088

# Postgres
POSTGRES_USER=rtfinance
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=rtfinance

# Segredos JWT — gere com: openssl rand -base64 48   (dois valores distintos)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# IA (NVIDIA NIM). ⚠️ gere uma chave NOVA — a usada em dev foi exposta.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_CONFIRM_THRESHOLD_CENTS=500000

# Transcrição de áudio do WhatsApp (Groq Whisper). Vazio = áudios recusados com aviso.
GROQ_API_KEY=

# WhatsApp (Evolution)
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=rtfinance
WHATSAPP_WEBHOOK_TOKEN=troque-por-um-token-forte
# vazio = qualquer telefone cadastrado num household é aceito (multi-casal)
WHATSAPP_ALLOWLIST=

# 1º household / super-admin (usado só no `db:seed` inicial)
SEED_HOUSEHOLD_NAME=Casa RT
SEED_OWNER_NAME=Filipe
SEED_OWNER_EMAIL=filipe@seudominio.com
SEED_OWNER_PASSWORD=troque-no-primeiro-login
SEED_PARTNER_NAME=Julia
SEED_PARTNER_EMAIL=julia@seudominio.com
SEED_PARTNER_PASSWORD=troque-no-primeiro-login
