{
  "name": "rt-finance",
  "version": "0.1.0",
  "private": true,
  "description": "RT Finance — assistente financeiro pessoal do casal (WhatsApp + painel web)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @rt-finance/api prisma migrate dev",
    "db:deploy": "pnpm --filter @rt-finance/api prisma migrate deploy",
    "db:seed": "pnpm --filter @rt-finance/api prisma db seed",
    "db:studio": "pnpm --filter @rt-finance/api prisma studio",
    "db:reset": "pnpm --filter @rt-finance/api prisma migrate reset"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
