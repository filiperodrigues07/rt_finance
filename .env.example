# ============================================================================
# RT Finance — variáveis de ambiente (backend)
# Copie para .env e preencha. NUNCA versionar o .env real.
# O frontend recebe SOMENTE as variáveis com prefixo VITE_ (ver apps/web).
# ============================================================================

# ---------- Aplicação ----------
NODE_ENV=development
API_PORT=3333
# URL pública da API (usada para montar o webhook do WhatsApp e links em notificações)
API_PUBLIC_URL=http://localhost:3333
# Origens permitidas no CORS (separadas por vírgula)
WEB_ORIGIN=http://localhost:5173
# Fuso usado para bucketing mensal, fechamento de fatura e vencimentos
APP_TIMEZONE=America/Sao_Paulo
APP_DEFAULT_CURRENCY=BRL

# ---------- Banco de dados ----------
# Dev local (docker-compose). Em produção use `fly secrets set DATABASE_URL=...`
DATABASE_URL=postgresql://rtfinance:rtfinance@localhost:5432/rtfinance?schema=public

# ---------- Autenticação ----------
# Segredos fortes e distintos. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie do refresh token no painel web
AUTH_COOKIE_NAME=rt_refresh
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# ---------- IA (provider inicial: NVIDIA NIM / build.nvidia.com) ----------
# "nvidia" (real) ou "mock" (regras locais, sem rede — usado também se faltar NVIDIA_API_KEY)
AI_PROVIDER=nvidia
# Endpoint OpenAI-compatível da NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Modelo padrão (bom em JSON estruturado, ~3-8s). Qualquer modelo instruct da sua conta serve.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Limites da interpretação
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_MS=25000

# ---------- WhatsApp (provider inicial: Evolution API, self-hosted) ----------
# "evolution" para produção; "console" em dev (só registra a resposta no log, não chama API)
WHATSAPP_PROVIDER=evolution
# URL da instância da Evolution API (container local ou app Fly)
EVOLUTION_BASE_URL=http://localhost:8080
# API key global definida na própria Evolution API
EVOLUTION_API_KEY=change-me-evolution
# Nome da "instância" (conexão de número) criada na Evolution
EVOLUTION_INSTANCE=rtfinance
# Token compartilhado que a Evolution envia no header do webhook para nós validarmos
WHATSAPP_WEBHOOK_TOKEN=change-me-webhook
# Telefones autorizados (E.164, separados por vírgula). Mensagens de outros números são ignoradas.
WHATSAPP_ALLOWLIST=+5511999999999,+5511888888888
# timeout de chamadas HTTP para a Evolution (ms) e teto de tamanho de áudio (bytes)
WHATSAPP_HTTP_TIMEOUT_MS=12000
AUDIO_MAX_BYTES=8000000

# ---------- Jobs / agendamento (pg-boss usa o próprio DATABASE_URL) ----------
JOBS_ENABLED=true
# Quantos meses à frente gerar lançamentos de recorrências
RECURRING_HORIZON_MONTHS=2
# Expiração de uma confirmação pendente no WhatsApp
PENDING_CONFIRMATION_TTL_MINUTES=30
# Acima deste valor (em centavos) toda criação exige confirmação, mesmo sem ambiguidade
AI_CONFIRM_THRESHOLD_CENTS=50000

# ---------- E-mail (redefinição de senha) ----------
# Sem SMTP_USER/SMTP_PASS o link de redefinição é apenas registrado no log (dev/CI).
# Gmail: ative a verificação em 2 etapas e gere uma "Senha de app".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RT Finance <no-reply@rtfinance.local>
PASSWORD_RESET_TTL_MINUTES=45

# ---------- Observabilidade ----------
LOG_LEVEL=info
SENTRY_DSN=

# ---------- Backups (job pg_dump) ----------
BACKUP_ENABLED=false
BACKUP_CRON=0 4 * * *
BACKUP_RETENTION_DAYS=14

# ---------- Seed inicial (usado só por `pnpm db:seed`) ----------
SEED_HOUSEHOLD_NAME=Casa RT
SEED_OWNER_NAME=Filipe
SEED_OWNER_EMAIL=filipe@rtfinance.local
SEED_OWNER_PASSWORD=rtfinance123
SEED_OWNER_PHONE=
SEED_PARTNER_NAME=Julia
SEED_PARTNER_EMAIL=julia@rtfinance.local
SEED_PARTNER_PASSWORD=rtfinance123
SEED_PARTNER_PHONE=
