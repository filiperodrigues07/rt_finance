# RT Finance — VPS. Copie para .env.prod e preencha. NÃO comitar o .env.prod.
#   openssl rand -hex 32   -> cada JWT secret
#   openssl rand -hex 24   -> EVOLUTION_API_KEY e WHATSAPP_WEBHOOK_TOKEN

# --- domínio ---
WEB_ORIGIN=https://rtfinance.filiperodrigues.tech
AUTH_COOKIE_DOMAIN=rtfinance.filiperodrigues.tech
WEB_PORT=8088

# --- banco (container próprio, não conflita com nada) ---
POSTGRES_USER=rtfinance
POSTGRES_PASSWORD=
POSTGRES_DB=rtfinance

# --- segredos ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_ALLOWLIST=
# timeout de chamadas HTTP para a Evolution (ms) e teto de tamanho de áudio (bytes)
WHATSAPP_HTTP_TIMEOUT_MS=12000
AUDIO_MAX_BYTES=8000000

# --- IA (gere chaves NOVAS — as de dev vazaram) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
AI_CONFIRM_THRESHOLD_CENTS=500000

# --- E-mail (redefinição de senha) — Gmail com "Senha de app" ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RT Finance <seu-email@gmail.com>
PASSWORD_RESET_TTL_MINUTES=45

# --- opcional: fixar uma versão específica das imagens (default = :latest) ---
# API_IMAGE=ghcr.io/filiperodrigues07/rt_finance-api:sha-xxxxxxx
# WEB_IMAGE=ghcr.io/filiperodrigues07/rt_finance-web:sha-xxxxxxx
